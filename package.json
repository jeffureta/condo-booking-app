{
  "name": "condo-booking-app",
  "version": "1.0.0",
  "description": "Accessible, 100% free condo booking system powered by Google Calendar and Google Apps Script",
  "main": "Code.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "sync:pricing": "node scripts/sync-db-pricing.js",
    "clasp:status": "clasp status",
    "clasp:push": "clasp push",
    "clasp:deploy": "clasp deploy",
    "ship": "node ~/.gemini/config/skills/smart-git-clasp/scripts/ship.js"
  },
  "keywords": [
    "google-apps-script",
    "google-calendar",
    "booking",
    "accessibility"
  ],
  "author": "jeffureta",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0"
  }
}
